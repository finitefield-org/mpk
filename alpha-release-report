Alpha demo reproduction:

```sh
(cd fixtures/go-alpha && go test ./...)
(cd go-tools/go2gir && go test -count=1 ./...)
(cd go-tools/go2gir && go build -o ../../target/debug/go2gir .)
(cd examples/max64 && ../../target/debug/go2gir . > /tmp/mpk-max64-go2gir.json)
python3 - <<'PY'
import json
from pathlib import Path

data = json.loads(Path("/tmp/mpk-max64-go2gir.json").read_text())
checked_gir = json.loads(Path("examples/max64/gir.json").read_text())
gir = data["gir"]
function_count = sum(len(pkg["functions"]) for pkg in gir["packages"])

assert data["status"] == "gir-lowered"
assert gir == checked_gir
assert function_count == 1
print(f"status={data['status']}")
print(f"gir_hash={gir['gir_hash']}")
print(f"matches_checked_in_gir={gir == checked_gir}")
print(f"function_count={function_count}")
PY
cargo test -p mpk-vc --test max64_example
cargo test -p mpk-vc --test alpha_corpus
cargo test -p mpk-api --test strategies \
  theory_strategy_proves_max64_simple_vc_through_checked_certificate
cargo run --quiet -p mpk-cli -- check fixtures/cert-basic/one-theorem.hex
cargo run --quiet -p mpk-cli -- package verify-certs \
  fixtures/package-manifest/valid/basic-package.json
```

Security gate detail:

```sh
command -v rg >/dev/null
rg -n '#!\[forbid\(unsafe_code\)\]' \
  crates/mpk-core/src/lib.rs \
  crates/mpk-cert/src/lib.rs \
  crates/mpk-kernel/src/lib.rs \
  crates/mpk-theory/src/lib.rs \
  crates/mpk-cli/src/main.rs \
  crates/mpk-api/src/lib.rs \
  crates/mpk-vc/src/lib.rs
if rg -n 'allow\(unsafe_code\)|expect\(unsafe_code\)' crates; then
  exit 1
fi
(cd go-tools/mpk-checker-ref && CGO_ENABLED=0 go test -count=1 ./...)
(cd go-tools/mpk-checker-ref && \
  ! rg -n '"unsafe"' . --glob '*.go')
(cd go-tools/mpk-checker-ref && \
  if CGO_ENABLED=0 go list -deps ./... | rg '^unsafe$'; then
    echo 'documented exception: unsafe appears in Go dependency closure'
  else
    exit 1
  fi)
```

The final security command confirms the documented Gate H exception: `unsafe`
appears through Go standard library dependencies. The checker source search
emits no matches. A strict policy form that fails on any dependency-closure
`unsafe` match would block release until the exception is approved or the gate
is refined.

