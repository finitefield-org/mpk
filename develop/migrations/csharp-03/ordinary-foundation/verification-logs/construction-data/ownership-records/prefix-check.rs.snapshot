fn read(path:&str)->mpk_cert::encode::Certificate {let s=std::fs::read_to_string(path).unwrap();let s=s.trim();let bytes=(0..s.len()).step_by(2).map(|i|u8::from_str_radix(&s[i..i+2],16).unwrap()).collect::<Vec<_>>();mpk_cert::decode_canonical_certificate(&bytes).unwrap()}
fn main(){let args=std::env::args().collect::<Vec<_>>();let a=read(&args[1]);let b=read(&args[2]);assert_eq!(a.level_table,&b.level_table[..a.level_table.len()]);assert_eq!(a.term_table,&b.term_table[..a.term_table.len()]);for (x,y) in a.declarations.iter().zip(&b.declarations){assert_eq!(x.kind,y.kind);assert_eq!(a.name_table[x.name as usize],b.name_table[y.name as usize]);}assert!(b.declarations.len()>=a.declarations.len());assert_eq!(a.proof_node_table,b.proof_node_table);assert_eq!(a.theory_certificates,b.theory_certificates);println!("unchanged prefix: {} declarations, {} terms; added {} declarations",a.declarations.len(),a.term_table.len(),b.declarations.len()-a.declarations.len());}
