        "utf8": "namespace Boundary;public enum E0:sbyte{Low=-128,Zero=0,High=127}public enum E1:byte{Zero=0,High=255}public enum E2:short{Low=-32768,Zero=0,High=32767}public enum E3:ushort{Zero=0,High=65535}public enum E4:int{Low=-2147483648,Zero=0,High=2147483647}public enum E5:uint{Zero=0,High=4294967295U}public enum E6:long{Low=-9223372036854775808L,Zero=0,High=9223372036854775807L}public enum E7:ulong{Zero=0,High=18446744073709551615UL}public readonly struct Payload{public readonly E0 V0;public readonly E1 V1;public readonly E2 V2;public readonly E3 V3;public readonly E4 V4;public readonly E5 V5;public readonly E6 V6;public readonly E7 V7;public Payload(E0 p0,E1 p1,E2 p2,E3 p3,E4 p4,E5 p5,E6 p6,E7 p7){V0=p0;V1=p1;V2=p2;V3=p3;V4=p4;V5=p5;V6=p6;V7=p7;}}public static class Entry{public static Payload Run(Payload p){return new Payload(p.V0,p.V1,p.V2,p.V3,p.V4,p.V5,p.V6,p.V7);}}\n"
