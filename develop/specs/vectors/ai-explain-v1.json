      "type": "object",
      "properties": {
        "overview": {"type": "string", "minLength": 1, "maxLength": 2000},
        "property_explanations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "property_ref": {"type": "string", "enum": ["property-0001"]},
              "explanation": {"type": "string", "minLength": 1, "maxLength": 500}
            },
            "required": ["property_ref", "explanation"],
            "additionalProperties": false
          }
        },
        "limitations": {
          "type": "array",
          "maxItems": 10,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "next_steps": {
          "type": "array",
          "maxItems": 10,
