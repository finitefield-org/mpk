  "mir_adapter_patterns": {
    "profile_id": "mpk.rust.mir.4d08223c.v0",
    "query": "mir_drops_elaborated_and_const_checked",
    "common_assert": {
      "normal_target": "required and unique",
      "unwind": "UnwindAction::Unreachable",
      "predicate_use_count": 1,
      "message_comparison": "enum discriminant and typed operand identity; never formatted prose"
    },
    "checked_add_sub_mul": {
      "operators": ["Add", "Sub", "Mul"],
      "overflowing_operators": ["AddWithOverflow", "SubWithOverflow", "MulWithOverflow"],
      "producer": "Assign(TUPLE, BinaryOp(OP_WITH_OVERFLOW, LHS, RHS))",
      "predicate": "Projection(TUPLE, Field(1: bool))",
      "assert_expected": false,
      "assert_message": "Overflow(BASE_OP, LHS, RHS)",
      "value": "Projection(TUPLE, Field(0)) has exactly one whole-place use on the normal path",
      "vir_checks": ["integer_no_overflow"]
    },
    "signed_neg": {
      "predicate": "Assign(PRED, BinaryOp(Eq, VALUE, MIN_OF_VALUE_TYPE))",
      "assert_condition": "PRED",
      "assert_expected": false,
      "assert_message": "OverflowNeg(VALUE)",
      "normal_operation": "UnaryOp(Neg, the same VALUE)",
      "vir_checks": ["integer_no_overflow"]
    },
    "signed_division_remainder": {
      "operators": ["Div", "Rem"],
      "zero_predicate": "Assign(ZERO, BinaryOp(Eq, RHS, zero of RHS type))",
      "zero_assert_expected": false,
      "zero_messages": ["DivisionByZero(LHS)", "RemainderByZero(LHS)"],
      "overflow_predicate": "BitAnd(Eq(RHS, -1 of RHS type), Eq(LHS, MIN_OF_LHS_TYPE))",
      "overflow_assert_expected": false,
      "overflow_message": "Overflow(OP, LHS, RHS)",
      "normal_operation": "BinaryOp(OP, the same LHS, the same RHS)",
      "vir_checks": ["divisor_nonzero", "signed_divrem_representable"]
    },
    "unsigned_division_remainder": {
      "operators": ["Div", "Rem"],
      "zero_predicate": "Assign(ZERO, BinaryOp(Eq, RHS, zero of RHS type))",
      "zero_assert_expected": false,
      "zero_messages": ["DivisionByZero(LHS)", "RemainderByZero(LHS)"],
      "normal_operation": "BinaryOp(OP, the same LHS, the same RHS)",
      "vir_checks": ["divisor_nonzero"]
    },
    "shift": {
      "operators": ["Shl", "Shr"],
      "signed_count_cast": "Assign(UNSIGNED_COUNT, Cast(IntToInt, COUNT, unsigned type of exactly COUNT width))",
      "unsigned_count": "COUNT without a cast",
      "predicate": "Assign(PRED, BinaryOp(Lt, UNSIGNED_COUNT, const LHS_WIDTH of UNSIGNED_COUNT type))",
      "assert_condition": "PRED",
      "assert_expected": true,
      "assert_message": "Overflow(OP, LHS, COUNT)",
      "normal_operation": "BinaryOp(OP, the same LHS, the original COUNT)",
      "signed_vir_checks": ["shift_count_nonnegative", "shift_count_less_than_width"],
      "unsigned_vir_checks": ["shift_count_less_than_width"]
    },
    "fixed_array_index": {
      "index_type": "target-width usize",
      "predicate": "Assign(PRED, BinaryOp(Lt, INDEX, const N_usize))",
      "assert_condition": "PRED",
      "assert_expected": true,
      "assert_message": "BoundsCheck(const N_usize, INDEX)",
      "normal_projection": "Index using the same INDEX into array length N",
      "vir_checks": ["index_in_bounds"]
    },
    "consumption": {
      "predicate_assignments_emit_vir": false,
      "assert_terminator": "Jump to its unique normal target",
      "alternate_predecessor": "RUST_MIR_CHECKED_PATTERN",
      "intervening_effect": "RUST_MIR_CHECKED_PATTERN",
      "reused_operand_or_predicate": "RUST_MIR_CHECKED_PATTERN"
    }
  },
