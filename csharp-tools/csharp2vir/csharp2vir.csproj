<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>csharp2vir</AssemblyName>
    <RootNamespace>Mpk.CSharp2Vir</RootNamespace>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <RestoreProjectStyle>None</RestoreProjectStyle>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Optimize>true</Optimize>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.cs" />
    <Compile Include="Capture.cs" />
    <Compile Include="Cli.cs" />
    <Compile Include="ContractAttachment.cs" />
    <Compile Include="ContractCanonical.cs" />
    <Compile Include="ContractModel.cs" />
    <Compile Include="ContractParser.cs" />
    <Compile Include="FrontendModel.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="RoslynAdapters.cs" />
    <Compile Include="RoslynSession.cs" />
    <Compile Include="Selection.cs" />
    <Compile Include="SourceTransport.cs" />
    <Compile Include="SubsetModel.cs" />
    <Compile Include="SubsetOperations.cs" />
    <Compile Include="SubsetSymbols.cs" />
    <Compile Include="SubsetValidator.cs" />
    <Reference Include="$(MpkReferenceRoot)/*.dll" />
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(MpkRoslynRoot)/Microsoft.CodeAnalysis.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(MpkRoslynRoot)/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
